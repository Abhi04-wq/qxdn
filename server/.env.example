NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/qndx
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# SMTP - leave empty in dev to auto-use Ethereal test transport (preview URL in console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=QNDX Staking

# Set to false in production to enforce invite-only registration
DISABLE_INVITE_REQUIREMENT=true
MASTER_INVITE_CODE=QNDX-FOUNDER

# Administrator Credentials (User ID & Password configurable from ENV)
ADMIN_EMAIL=admin@qndx.io
ADMIN_PASSWORD=AdminPass123
